# ---------------------------------------------------------------------------
# Local database artifacts
# ---------------------------------------------------------------------------
# Compose mounts Postgres data in a named volume, but keep stray local dumps,
# SQLite files and pgdata directories out of the repository.
pgdata/
postgres-data/
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
*.bak

# ---------------------------------------------------------------------------
# Data (never commit datasets - see docs/data.md)
# ---------------------------------------------------------------------------
# Ignore the CONTENTS, not the directories themselves: git cannot re-include a
# file whose parent directory is excluded, so `data/raw/*` (not `data/raw/`) is
# what lets the .gitkeep and README below survive.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/raw/README.md
!data/processed/README.md
*.csv
*.parquet
*.feather
*.zip
*.gz
*.tar
!docs/**/*.csv

# ---------------------------------------------------------------------------
