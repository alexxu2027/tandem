# ---------------------------------------------------------------------------
# Tandem - example environment file
#
# Copy to `.env` at the repository root and adjust as needed:
#     cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials or API keys.
# Every timestamp in Tandem is UTC; there is no timezone to configure.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=Tandem API
ENVIRONMENT=local            # local | test | staging | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Backend server --------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL / PostGIS --------------------------------------------------
# These are read by both Docker Compose (to provision the container) and the
# backend (to connect). Change the password before deploying anywhere real.
POSTGRES_USER=tandem
POSTGRES_PASSWORD=tandem
POSTGRES_DB=tandem
POSTGRES_PORT=5432

# Host the backend uses to reach Postgres.
#   localhost -> backend running on your machine (default)
#   db        -> backend running inside Docker Compose
POSTGRES_HOST=localhost

# Optional: overrides the POSTGRES_* pieces above when set. Leave empty to have
# the backend assemble the URL itself. Must use the psycopg (v3) driver.
# DATABASE_URL=postgresql+psycopg://tandem:tandem@localhost:5432/tandem

# --- Frontend --------------------------------------------------------------
# Next.js only exposes NEXT_PUBLIC_* variables to the browser. Copy this into
# frontend/.env.local as well if you run the frontend outside Compose.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- External data sources (not yet used) ----------------------------------
# Placeholders for the ingestion pipelines that get built next. The Citi Bike
# GBFS feeds are public and unauthenticated; weather and NYC Open Data are not.
# CITIBIKE_GBFS_URL=https://gbfs.citibikenyc.com/gbfs/2.3/gbfs.json
# NOAA_API_TOKEN=
# OPENWEATHER_API_KEY=
# NYC_OPEN_DATA_APP_TOKEN=
